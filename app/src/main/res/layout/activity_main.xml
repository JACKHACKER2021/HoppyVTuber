<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <io.github.sceneview.SceneView
        android:id="@+id/sceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- horní plovoucí pilulka -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#B3141820"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hoppy"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="● hledám obličej…"
                android:textColor="#FFB74D"
                android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- náhled kamery -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/camCard"
        android:layout_width="84dp"
        android:layout_height="112dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:strokeColor="#5BD07A"
        app:strokeWidth="2dp">
        <androidx.camera.view.PreviewView
            android:id="@+id/camPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/recBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="#CC000000"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="● REC · klepni na postavu pro ovládání"
        android:textColor="#FF5555"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- spodní skleněná karta -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        app:cardBackgroundColor="#E6141820"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:paddingTop="14dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="14dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.chip.Chip android:id="@+id/chipArms" style="@style/Widget.Hoppy.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:checkable="true" android:text="🙌 Ruce" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipWave" style="@style/Widget.Hoppy.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:checkable="true" android:text="👋 Mávat" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipHappy" style="@style/Widget.Hoppy.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:checkable="true" android:text="😊 Radost" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipBlush" style="@style/Widget.Hoppy.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:checkable="true" android:text="😳 Blush" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipBg" style="@style/Widget.Hoppy.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:checkable="false" android:text="🎨 Pozadí" />
                    <com.google.android.material.chip.Chip android:id="@+id/chipCalib" style="@style/Widget.Hoppy.Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="false" android:text="🎯 Kalibrovat" />
                </LinearLayout>
            </HorizontalScrollView>

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/btnRec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#E04545"
                android:text="●  Nahrát video"
                android:textColor="#FFFFFF"
                app:elevation="0dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
